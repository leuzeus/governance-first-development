{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leuzeus/governance-first-development/schemas/attempt-record.schema.json",
  "title": "GFD attempt declaration",
  "description": "Immutable declaration of a bounded execution intended to produce evidence, a product result, or a gate verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "attempt_id",
    "created_at",
    "purpose",
    "actor",
    "authority_refs",
    "governance_identity",
    "planned_gates",
    "target_product_gate",
    "source_occurrence_id",
    "promotion_basis",
    "relations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "attempt"
    },
    "attempt_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identifier"],
      "properties": {
        "kind": {
          "enum": ["human", "agent", "automation"]
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "governance_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version", "criteria_id", "criteria_sha256"],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "criteria_id": {
          "type": "string",
          "minLength": 1
        },
        "criteria_sha256": {
          "type": ["string", "null"],
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "planned_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/planned_gate"
      }
    },
    "target_product_gate": {
      "oneOf": [
        {"$ref": "#/$defs/identifier"},
        {"type": "null"}
      ]
    },
    "product_artifact_ref": {
      "type": ["string", "null"]
    },
    "source_occurrence_id": {
      "oneOf": [
        {"$ref": "#/$defs/identifier"},
        {"type": "null"}
      ]
    },
    "promotion_basis": {
      "enum": [
        "declared_attempt",
        "material_impact",
        "recurrence",
        "causal_significance",
        null
      ]
    },
    "context_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "planned_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "sequence", "kind", "authority_ref", "description"],
      "properties": {
        "gate_id": {
          "$ref": "#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": ["preparatory", "product", "evidence", "other"]
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_id"],
      "properties": {
        "type": {
          "enum": ["retries", "supersedes", "caused_by"]
        },
        "target_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
